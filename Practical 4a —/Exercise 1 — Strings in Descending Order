#include <stdio.h>
#include <string.h>

int main() {
    char a[100][50], key[50];
    int n, low, high, mid, found = 0;

    printf("Enter number of strings: ");
    scanf("%d", &n);

    printf("Enter strings in descending order: ");
    for (int i = 0; i < n; i++)
        scanf("%s", a[i]);

    printf("Enter string to search: ");
    scanf("%s", key);

    low = 0;
    high = n - 1;

    while (low <= high) {
        mid = (low + high) / 2;

        if (strcmp(a[mid], key) == 0) {
            printf("String found at position %d", mid + 1);
            found = 1;
            break;
        }
        else if (strcmp(key, a[mid]) < 0)
            low = mid + 1;
        else
            high = mid - 1;
    }

    if (!found)
        printf("String Not Found");

    return 0;
}
