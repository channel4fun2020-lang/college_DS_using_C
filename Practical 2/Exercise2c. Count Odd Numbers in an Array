#include <stdio.h>

int main()
{
    int a[100], n, i, count = 0;

    printf("Enter size: ");
    scanf("%d", &n);

    printf("Enter elements:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    for(i = 0; i < n; i++)
    {
        if(a[i] & 1)
            count++;
    }

    printf("Odd numbers = %d", count);

    return 0;
}
