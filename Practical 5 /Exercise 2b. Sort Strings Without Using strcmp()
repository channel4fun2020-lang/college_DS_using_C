#include <stdio.h>
#include <string.h>

int main()
{
    char a[100][50], temp[50];
    int n, i, j, k, greater;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%s", a[i]);

    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - i - 1; j++)
        {
            k = 0;
            greater = 0;

            while(a[j][k] == a[j + 1][k] &&
                  a[j][k] != '\0')
            {
                k++;
            }

            if(a[j][k] > a[j + 1][k])
                greater = 1;

            if(greater)
            {
                strcpy(temp, a[j]);
                strcpy(a[j], a[j + 1]);
                strcpy(a[j + 1], temp);
            }
        }
    }

    for(i = 0; i < n; i++)
        printf("%s\n", a[i]);

    return 0;
}
