#include <stdio.h>
#include <string.h>

int main()
{
    char a[100][50], longest[50];
    int n, i;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%s", a[i]);

    strcpy(longest, a[0]);

    for(i = 1; i < n; i++)
    {
        if(strlen(a[i]) > strlen(longest))
            strcpy(longest, a[i]);
    }

    printf("Longest string = %s", longest);

    return 0;
}
