#include <stdio.h>
#include <string.h>

int main()
{
    char a[100][50], shortest[50];
    int n, i;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%s", a[i]);

    strcpy(shortest, a[0]);

    for(i = 1; i < n; i++)
    {
        if(strlen(a[i]) < strlen(shortest))
            strcpy(shortest, a[i]);
    }

    printf("Shortest string = %s", shortest);

    return 0;
}
