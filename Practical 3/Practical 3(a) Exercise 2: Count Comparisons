#include <stdio.h>

int main()
{
    int a[100],n,key,i,count=0;

    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%d",&a[i]);

    scanf("%d",&key);

    for(i=0;i<n;i++)
    {
        count++;
        if(a[i]==key)
            break;
    }

    printf("Comparisons = %d",count);

    return 0;
}
