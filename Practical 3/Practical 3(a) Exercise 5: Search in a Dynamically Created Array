#include <stdio.h>
#include <stdlib.h>

int main()
{
    int *a,n,key,i,flag=0;

    scanf("%d",&n);

    a=(int*)malloc(n*sizeof(int));

    for(i=0;i<n;i++)
        scanf("%d",&a[i]);

    scanf("%d",&key);

    for(i=0;i<n;i++)
    {
        if(a[i]==key)
        {
            printf("Found at position %d",i+1);
            flag=1;
            break;
        }
    }

    if(flag==0)
        printf("Not Found");

    free(a);

    return 0;
}
